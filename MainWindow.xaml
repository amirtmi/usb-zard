<Window x:Class="UsbWriteGuard.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="usb zard" Icon="Assets/app.ico" Width="1150" Height="800" MinWidth="900" MinHeight="680" Background="#FAFAF7" FontFamily="Segoe UI" FontSize="14" Closing="OnClosing">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel><ComboBox x:Name="LanguagePicker" DockPanel.Dock="Right" Width="140" VerticalAlignment="Center" Height="34" SelectedIndex="0" SelectionChanged="LanguageChanged"><ComboBoxItem>فارسی</ComboBoxItem><ComboBoxItem>English</ComboBoxItem></ComboBox><Image Source="Assets/logo.png" Width="76" Height="76" Margin="0,0,16,0" DockPanel.Dock="Left"/><StackPanel><TextBlock Text="usb zard" FontSize="30" FontWeight="SemiBold" Foreground="#222222"/><TextBlock x:Name="Subtitle" Margin="0,6,0,12"/></StackPanel></DockPanel>
<Border Grid.Row="1" Background="#FFF0D4" Padding="14" CornerRadius="8" Margin="0,8"><TextBlock x:Name="Limits" Foreground="#744B00"/></Border>
<StackPanel Grid.Row="2" x:Name="Controls"><Border Background="#FFF6C8" CornerRadius="6" Padding="10" Margin="0,4"><TextBlock x:Name="Summary" FontWeight="SemiBold"/></Border><WrapPanel Margin="0,8"><Button x:Name="ScanButton" Click="ScanClick"/><Button x:Name="DemoButton" Click="DemoClick"/><TextBlock x:Name="DeviceLabel" VerticalAlignment="Center" Margin="14,0,6,0"/><ComboBox x:Name="Devices" Width="590" DisplayMemberPath="Display" SelectionChanged="DeviceChanged"/></WrapPanel>
<WrapPanel><Button x:Name="DiagnoseButton" Click="DiagnoseClick"/><Button x:Name="ClearButton" Click="ClearClick"/><Button x:Name="RescanButton" Click="RescanClick"/><Button x:Name="PolicyButton" Click="PolicyClick"/><Button x:Name="ProbeButton" Click="ProbeClick" Background="#FFE16A"/></WrapPanel>
<WrapPanel Margin="0,4,0,12"><TextBlock x:Name="VolumeLabel" VerticalAlignment="Center" Margin="4"/><ComboBox x:Name="Volumes" Width="220" DisplayMemberPath="Display" SelectionChanged="VolumeChanged"/><Button x:Name="VolumeButton" Click="VolumeClick"/><Button x:Name="CheckButton" Click="CheckClick"/><Button x:Name="RepairButton" Click="RepairClick"/><ComboBox x:Name="FileSystems" Width="90" SelectedIndex="0"><ComboBoxItem>exFAT</ComboBoxItem><ComboBoxItem>NTFS</ComboBoxItem><ComboBoxItem>FAT32</ComboBoxItem></ComboBox><Button x:Name="FormatButton" Click="FormatClick" Background="#FFE0DE" Foreground="#92231D"/></WrapPanel>
</StackPanel>
<TabControl Grid.Row="3"><TabItem Header="گزارش / Report"><TextBox x:Name="Report" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Segoe UI" Padding="15" BorderThickness="0"/></TabItem><TabItem Header="JSON / جزئیات خام"><TextBox x:Name="Raw" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="12"/></TabItem></TabControl>
<DockPanel Grid.Row="4" Margin="0,12,0,0"><Button x:Name="ExportButton" DockPanel.Dock="Right" Click="ExportClick"/><TextBlock x:Name="Status" VerticalAlignment="Center" Foreground="#34516F"/></DockPanel>
</Grid></Window>